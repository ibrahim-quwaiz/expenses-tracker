# Neon Postgres connection string (project: expense-tracker)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Anthropic API key, used by /api/expenses/parse-sms to extract data from bank SMS text
ANTHROPIC_API_KEY=sk-ant-...

# Cloudflare R2 (S3-compatible), used by /api/stores/[id]/logo to store store logos
R2_ACCOUNT_ID=...
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET=expense-tracker-logos
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
